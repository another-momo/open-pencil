#!/usr/bin/env bash
# Pre-commit hook for rebuild/v2.
#
# Runs the lightweight governance checks before each commit. Heavy checks
# (lint, type-check, tests) stay in CI to avoid slowing down the dev loop.
#
#   check:zones    — every commit (git-diff only, cheap); zone purity can be
#                    broken by ANY upstream file change, not just docs.
#   check:docs     — only when docs/rebuild/*.md staged
#   check:bindings — only when docs/rebuild/*.md staged
#   check:tasks    — only when docs/rebuild/*.md staged
#
# Setup (one time, per clone / worktree):
#   bun run hooks:install
# Or: git config core.hooksPath tools/hooks
#
# Bypass (emergency only):
#   git commit --no-verify
# Or set CHECK_HOOKS_SKIP=1 in the environment.

set -e

if [ -n "$CHECK_HOOKS_SKIP" ]; then
  echo "check-hooks: CHECK_HOOKS_SKIP=1, 跳过"
  exit 0
fi

echo "pre-commit: 跑 check:zones..."
bun run check:zones

# doc 三检查仅在 docs/rebuild/*.md 改动时触发
changed_docs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/rebuild/.*\.md$' || true)

if [ -z "$changed_docs" ]; then
  echo "pre-commit: 无 docs/ 改动，跳过 check-docs/bindings/tasks"
  exit 0
fi

echo "pre-commit: 改动文件:"
echo "$changed_docs" | sed 's/^/  /'

echo "pre-commit: 跑 check:docs..."
bun run check:docs

echo "pre-commit: 跑 check:bindings..."
bun run check:bindings

echo "pre-commit: 跑 check:tasks..."
bun run check:tasks

echo "pre-commit: 全绿 ✅"
