#!/usr/bin/env bash
# Pre-commit hook for rebuild/v2.
#
# Runs the lightweight governance checks before each commit. Heavy checks
# (lint, type-check, tests) stay in CI to avoid slowing down the dev loop.
#
#   check:zones    — every commit (git-diff only, cheap); zone purity can be
#                    broken by ANY upstream file change, not just docs.
#
# docs/rebuild moved to docs/archive/rebuild-campaign (frozen 2026-09-06),
# so check:docs / check:tasks are retired and no longer invoked here.
# (check:bindings stayed wired only because it is still called from CI
# rebuild-discipline; check:tasks invocations on >=10 files or >=200
# lines are dropped along with the underlying script.)
#
# Setup (one time, per clone / worktree):
#   bun run hooks:install
# Or: git config core.hooksPath tools/hooks
#
# Bypass (emergency only):
#   git commit --no-verify
# Or set CHECK_HOOKS_SKIP=1 in the environment.

set -e

if [ -n "$CHECK_HOOKS_SKIP" ]; then
  echo "check-hooks: CHECK_HOOKS_SKIP=1, 跳过"
  exit 0
fi

echo "pre-commit: 跑 check:zones..."
bun run check:zones

# docs/rebuild 整体退役 → docs/archive/rebuild-campaign（冻结 2026-09-06）；
# check:docs / check:tasks 同步退役，本钩子不再触发。
# （check:bindings 仍由 CI rebuild-discipline job 拉起，本钩不重复挂载。）

echo "pre-commit: 全绿 ✅"
